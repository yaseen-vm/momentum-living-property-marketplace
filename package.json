{
  "name": "momentum-living",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "lint": "eslint apps packages --ext .ts,.tsx",
    "typecheck": "tsc -b apps/api/tsconfig.json apps/web/tsconfig.json apps/ingestion/tsconfig.json packages/shared/tsconfig.json",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "deploy:api": "pnpm --filter api deploy",
    "deploy:web": "pnpm --filter web deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
